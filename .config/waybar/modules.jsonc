{
  "clock": {
    "interval": 1,
    "format": "{:%a %d/%m  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
  }, 
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "tooltip": true,
    "format-muted": "",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ""
    },
  },
    "hyprland/workspaces": {
    // "format": "{icon}",
    // "format-icons": {
	    // "active": "",
	    // "default": ""
  },
  "tray": {
    "icon-size": 21,
    "spacing": 10,
    "icons": {
    },
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 200,
    // if i ever wanted to do custom titles
    "rewrite": {
      "(.*) — Mozilla Firefox": "🌍   $1",
    // Kitty
      "(.*)~": "🖥️   $1",
      "~/(.*)": "🖥️   $1",
      "nvim (.*)": "🧙‍♂️   $1",
      "(.*)Vesktop": "Discord $1"

    },
  },
  "hyprland/windowcount": {
    "format": "[{}]"
  },
  // Come back to later but idk
  "custom/kblayout": {
   // "exec": "~/.config/scripts/kblayout_update.sh",
   // "interval": 60,
   // "signal": 1,
   // "format": "Test: {text}"

}
}
